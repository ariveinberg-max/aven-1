# Copy to .env (git-ignored). Never commit real values.
NEUROLAYER_API_DOCS=1                    # 1 enables /docs locally; keep 0 in production
NEUROLAYER_AUTH_DISABLED=1               # LOCAL DEVELOPMENT ONLY; never set in production
NEUROLAYER_MODELS_DIR=artifacts/models   # model bundles (<name>/<version>/bundle.json)
NEUROLAYER_CORS_ORIGINS=http://localhost:3000
NEUROLAYER_RATE_LIMIT_PER_MINUTE=600
NEUROLAYER_SESSION_TTL_S=3600
# NEUROLAYER_JWT_SECRET=                 # Supabase project JWT secret (>= 32 bytes); use a secret manager in production
# NEUROLAYER_JWT_AUDIENCE=authenticated
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
