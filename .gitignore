# ---- data, weights, run outputs (never in git; see docs/architecture/security-and-privacy.md)
# Everything under data/ is ignored except DVC pointer files, their .gitignore files and the README.
data/**
!data/**/
!data/README.md
!data/**/*.dvc
!data/**/.gitignore
artifacts/
mlruns/
mlartifacts/
*.edf
*.bdf
*.gdf
*.fif
*.set
*.fdt
*.vhdr
*.vmrk
*.eeg
*.xdf
*.cnt
*.mat
*.nwb
*.npy
*.npz
*.h5
*.hdf5
*.zarr
*.parquet
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.pickle
*.joblib

# ---- secrets
.env
.env.*
!.env.example
*.pem
*.key

# ---- python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
dist/
build/
.import_linter_cache/

# ---- notebooks
.ipynb_checkpoints/

# ---- node / next
node_modules/
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
*.tsbuildinfo

